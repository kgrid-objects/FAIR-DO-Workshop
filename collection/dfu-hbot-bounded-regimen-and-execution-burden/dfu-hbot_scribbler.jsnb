{
  "metadata": {"name": "DFU HBOT Bounded Regimen and Execution Burden (Scribbler)", "language_info": {"name": "JavaScript", "version": "ES2020"}},
  "jsnbversion": "v0.1",
  "run_on_load": false,
  "source": "https://github.com/kgrid-objects/FAIR-DO-Workshop/tree/HEAD/collection/dfu-hbot-bounded-regimen-and-execution-burden",
  "cells": [
    {"type":"html","code":"<h1>DFU HBOT Bounded Regimen and Execution Burden</h1><p>Interactive Scribbler demonstration of the regimen range, burden questionnaire, and burden response analysis.</p>","status":"","output":""},
    {"type":"code","code":"function showRegimenRange(request) { if (!request || request.request_type !== 'show_regimen_range') throw new Error('request_type must be show_regimen_range.'); return { specification_iri:'https://kgrid.org/cks/dfu-hbot-burden/versions/cks-1.0', response_type:'fixed_regimen_range_response', status:'completed', knowledge_package_iri:'https://kgrid.org/cks/dfu-hbot-burden/knowledge-packages/general-dfu-regimen/versions/1.0', knowledge_scope:'general_not_patient_specific', indication:'diabetes_related_foot_ulcer', shorter_regimen_scenario:{episodes:30,sessions_per_week:5,course_weeks:6.0}, longer_regimen_scenario:{episodes:40,sessions_per_week:5,course_weeks:8.0}, combined_range:{episodes:[30,40],sessions_per_week:5,course_weeks:[6.0,8.0]}, scheduled_facility_hours_per_episode:{value:3.0,unit:'h'}, tailored_to_patient:false, display_label:'General DFU HBOT planning range: approximately 30-40 episodes, usually five per week, over approximately 6-8 weeks.'}; } globalThis.showRegimenRange=showRegimenRange; globalThis.scrib.show('<h3>Regimen Range loaded.</h3>');","status":"","output":""},
    {"type":"code","code":"const PROVIDER_ROSTER_VERSION_IRI='https://kgrid.org/cks/dfu-hbot-burden/provider-rosters/appendix-e/versions/1.0'; const QUESTIONS=[{id:'Q01',text:'Where will you receive hyperbaric oxygen therapy?',prompt:'Enter provider IRI (example: https://kgrid.org/cks/dfu-hbot-burden/providers/e-001):'},{id:'Q02',text:'About how many miles is it one way to this location?',prompt:'Enter one_way_miles (0 to 1000):'},{id:'Q03',text:'About how long does that trip usually take one way?',prompt:'Enter one_way_travel_minutes (0 to 1440):'},{id:'Q04',text:'How much difficulty do you expect with attending scheduled treatments?',prompt:'Enter difficulty [none|some|major]:'}]; async function promptLine(promptText){if(globalThis.$$&&typeof globalThis.$$.input==='function')return globalThis.$$.input({prompt:promptText});const raw=typeof prompt==='function'?prompt(promptText):'';return Promise.resolve(raw==null?'':String(raw));} async function runBurdenQuestionnaire(){const a={};for(const q of QUESTIONS){console.log(`\\n${q.id}: ${q.text}`);a[q.id]=String(await promptLine(`${q.prompt} `)).trim();}const p=a.Q01,m=Number(a.Q02),t=Number(a.Q03),d=a.Q04.toLowerCase();if(!/^https:\\/\\/kgrid\\.org\\/cks\\/dfu-hbot-burden\\/providers\\/e-(00[1-9]|0[1-9][0-9]|1[0-3][0-9]|14[01])$/.test(p))throw new Error('Q01 must be a valid provider IRI.');if(!Number.isFinite(m)||m<0||m>1000)throw new Error('Q02 must be 0 through 1000.');if(!Number.isFinite(t)||t<0||t>1440)throw new Error('Q03 must be 0 through 1440.');if(!['none','some','major'].includes(d))throw new Error('Q04 must be none, some, or major.');return{provider_roster_version_iri:PROVIDER_ROSTER_VERSION_IRI,response_projection:{hyperbaric_oxygen_therapy_location:p,one_way_miles:m,one_way_travel_minutes:t,weekday_attendance_difficulty:d},confirmed:true};} globalThis.runBurdenQuestionnaire=runBurdenQuestionnaire; globalThis.scrib.show('<h3>Interactive questionnaire loaded.</h3>');","status":"","output":""},
    {"type":"code","code":"const ROSTER_URL='https://raw.githubusercontent.com/kgrid-objects/FAIR-DO-Workshop/HEAD/collection/dfu-hbot-bounded-regimen-and-execution-burden/spec/DFU_HBOT_Provider_Roster_Snapshot_Version_1_0.json'; async function calculateBurdenRange(q,r){const roster=await fetch(ROSTER_URL).then(x=>x.json()),p=q.response_projection,provider=roster.records.find(x=>x.provider_iri===p.hyperbaric_oxygen_therapy_location);if(!provider||!provider.selectable)throw new Error('Selected provider was not found in the selectable roster.');const t=p.one_way_travel_minutes*2/60,d=p.one_way_miles*2,band=t<1?'low':t<2?'moderate':t<3?'high':'very_high',score=p.weekday_attendance_difficulty==='major'?(band==='low'?4:5):p.weekday_attendance_difficulty==='some'?Math.min(5,{low:1,moderate:2,high:3,very_high:4}[band]+1):{low:1,moderate:2,high:3,very_high:4}[band],cats=['low_execution_burden','moderate_execution_burden','high_execution_burden','very_high_execution_burden','extreme_execution_burden'],out={shorter_regimen:{episodes:30,course_weeks:6,travel_hours:Math.floor(30*t),facility_hours:90,total_patient_hours:Math.floor(30*(t+3)),course_miles:Math.floor(30*d)},longer_regimen:{episodes:40,course_weeks:8,travel_hours:Math.ceil(40*t),facility_hours:120,total_patient_hours:Math.ceil(40*(t+3)),course_miles:Math.ceil(40*d)}};return{status:'completed',result_code:`RESULT-${cats[score-1].toUpperCase()}`,selected_location:{provider_iri:provider.provider_iri,compact_id:provider.compact_id,facility_listing:provider.facility_listing,jurisdiction:provider.jurisdiction,normalized_address_candidate:provider.normalized_address_candidate},reported_one_way_travel:{miles:p.one_way_miles,minutes:p.one_way_travel_minutes},regimen_range:r.combined_range,burden_by_regimen_scenario:out,travel_band:band,weekday_attendance_difficulty:p.weekday_attendance_difficulty,execution_burden_level:{score,category:cats[score-1]},assumptions:['30-40 general episodes','3 scheduled facility hours per episode','Round trip uses twice one-way travel','Travel values are user-reported']};} globalThis.calculateBurdenRange=calculateBurdenRange; globalThis.scrib.show('<h3>Burden analysis loaded.</h3>');","status":"","output":""},
    {"type":"html","code":"<h2>Run the DFU HBOT Questionnaire and Analysis</h2><p>Answer the four questions to see the regimen and burden results.</p>","status":"","output":""},
    {"type":"code","code":"(async()=>{try{const q=await globalThis.runBurdenQuestionnaire();globalThis.scrib.show('<h3>Questionnaire Response</h3><pre>'+JSON.stringify(q,null,2)+'</pre>');const r=globalThis.showRegimenRange({request_type:'show_regimen_range'});globalThis.scrib.show('<h3>Regimen Range</h3><pre>'+JSON.stringify(r,null,2)+'</pre>');const a=await globalThis.calculateBurdenRange(q,r);globalThis.scrib.show('<h3>Burden Analysis</h3><pre>'+JSON.stringify(a,null,2)+'</pre>');globalThis.questionnaireAndAnalysis={questionnaireResponse:q,regimenRangeResponse:r,analysisResult:a};}catch(error){globalThis.scrib.show('<pre>'+String(error&&error.message?error.message:error)+'</pre>');throw error;}})();","status":"","output":""}
  ]
}
