{
  "metadata": {"name": "DFU HBOT Bounded Regimen and Execution Burden (Scribbler)", "language_info": {"name": "JavaScript", "version": "ES2020"}},
  "jsnbversion": "v0.1",
  "run_on_load": false,
  "source": "https://github.com/kgrid-objects/FAIR-DO-Workshop/tree/HEAD/collection/dfu-hbot-bounded-regimen-and-execution-burden",
  "cells": [
    {"type":"html","code":"<h1>DFU HBOT Bounded Regimen and Execution Burden</h1><p>Interactive Scribbler demonstration of the regimen range, burden questionnaire, and burden response analysis.</p>","status":"","output":""},
    {"type":"code","code":"function showRegimenRange(request) {\u000a  if (!request || request.request_type !== 'show_regimen_range') {\u000a    throw new Error('request_type must be show_regimen_range.');\u000a  }\u000a\u000a  return {\u000a    response_type: 'fixed_regimen_range_response',\u000a    status: 'completed',\u000a    shorter_regimen_scenario: { episodes: 30, sessions_per_week: 5, course_weeks: 6.0 },\u000a    longer_regimen_scenario: { episodes: 40, sessions_per_week: 5, course_weeks: 8.0 },\u000a    combined_range: { episodes: [30, 40], sessions_per_week: 5, course_weeks: [6.0, 8.0] },\u000a    scheduled_facility_hours_per_episode: { value: 3.0, unit: 'h' },\u000a    tailored_to_patient: false\u000a  };\n}\n\nglobalThis.showRegimenRange = showRegimenRange;\nglobalThis.scrib.show('<h3>Regimen Range loaded.</h3>');","status":"","output":""},
    {"type":"code","code":"const QUESTIONS = [\u000a  { id: 'Q01', text: 'Where will you receive hyperbaric oxygen therapy?', prompt: 'Enter provider IRI:' },\u000a  { id: 'Q02', text: 'About how many miles is it one way to this location?', prompt: 'Enter one_way_miles (0 to 1000):' },\u000a  { id: 'Q03', text: 'About how long does that trip usually take one way?', prompt: 'Enter one_way_travel_minutes (0 to 1440):' },\u000a  { id: 'Q04', text: 'How much difficulty do you expect with attending scheduled treatments?', prompt: 'Enter difficulty [none|some|major]:' }\n];\n\nfunction promptLine(promptText) {\n  if (globalThis.$$ && typeof globalThis.$$.input === 'function') {\n    return globalThis.$$.input({ prompt: promptText });\n  }\n  const raw = typeof prompt === 'function' ? prompt(promptText) : '';\n  return Promise.resolve(raw == null ? '' : String(raw));\n}\n\nasync function runBurdenQuestionnaire() {\n  const answers = {};\n  for (const question of QUESTIONS) {\n    const message = `${question.id}: ${question.text}\\n\\n${question.prompt}`;\n    globalThis.scrib.show(`<pre>${message}</pre>`);\n    answers[question.id] = String(await promptLine(question.prompt)).trim();\n  }\n  return {\n    response_projection: {\n      hyperbaric_oxygen_therapy_location: answers.Q01,\n      one_way_miles: Number(answers.Q02),\n      one_way_travel_minutes: Number(answers.Q03),\n      weekday_attendance_difficulty: answers.Q04.toLowerCase()\n    },\n    confirmed: true\n  };\n}\n\nglobalThis.runBurdenQuestionnaire = runBurdenQuestionnaire;\nglobalThis.scrib.show('<h3>Interactive questionnaire loaded.</h3>');","status":"","output":""},
    {"type":"code","code":"const ROSTER_URL = 'https://raw.githubusercontent.com/kgrid-objects/FAIR-DO-Workshop/HEAD/collection/dfu-hbot-bounded-regimen-and-execution-burden/spec/DFU_HBOT_Provider_Roster_Snapshot_Version_1_0.json';\n\nasync function calculateBurdenRange(questionnaireResponse, regimenRangeResponse) {\n  const roster = await fetch(ROSTER_URL).then((response) => response.json());\n  const projection = questionnaireResponse.response_projection;\n  const provider = roster.records.find((record) => record.provider_iri === projection.hyperbaric_oxygen_therapy_location);\n  if (!provider) throw new Error('Selected provider was not found in the roster.');\n\n  const roundTripHours = projection.one_way_travel_minutes * 2 / 60;\n  const roundTripMiles = projection.one_way_miles * 2;\n  const scenarios = [\n    { name: 'shorter_regimen', episodes: 30, weeks: 6.0 },\n    { name: 'longer_regimen', episodes: 40, weeks: 8.0 }\n  ];\n  const burden = {};\n  for (const scenario of scenarios) {\n    const travel = scenario.episodes * roundTripHours;\n    burden[scenario.name] = {\n      episodes: scenario.episodes,\n      course_weeks: scenario.weeks,\n      travel_hours: Math.round(travel * 10) / 10,\n      facility_hours: scenario.episodes * 3,\n      total_patient_hours: Math.round((travel + scenario.episodes * 3) * 10) / 10,\n      course_miles: Math.round(scenario.episodes * roundTripMiles)\n    };\n  }\n\n  return {\n    status: 'completed',\n    regimen_range: regimenRangeResponse.combined_range,\n    selected_location: { provider_iri: provider.provider_iri, compact_id: provider.compact_id, facility_listing: provider.facility_listing },\n    burden_by_regimen_scenario: burden,\n    travel_band: roundTripHours < 1 ? 'low' : roundTripHours < 2 ? 'moderate' : roundTripHours < 3 ? 'high' : 'very_high',\n    weekday_attendance_difficulty: projection.weekday_attendance_difficulty\n  };\n}\n\nglobalThis.calculateBurdenRange = calculateBurdenRange;\nglobalThis.scrib.show('<h3>Burden analysis loaded.</h3>');","status":"","output":""},
    {"type":"html","code":"<h2>Run the DFU HBOT Questionnaire and Analysis</h2><p>Answer the four questions to see the regimen and burden results.</p>","status":"","output":""},
    {"type":"code","code":"(async () => {\n  const questionnaireResponse = await globalThis.runBurdenQuestionnaire();\n  globalThis.scrib.show('<h3>Questionnaire Response</h3><pre>' + JSON.stringify(questionnaireResponse, null, 2) + '</pre>');\n\n  const regimenRangeResponse = globalThis.showRegimenRange({ request_type: 'show_regimen_range' });\n  globalThis.scrib.show('<h3>Regimen Range</h3><pre>' + JSON.stringify(regimenRangeResponse, null, 2) + '</pre>');\n\n  const analysisResult = await globalThis.calculateBurdenRange(questionnaireResponse, regimenRangeResponse);\n  globalThis.scrib.show('<h3>Burden Analysis</h3><pre>' + JSON.stringify(analysisResult, null, 2) + '</pre>');\n\n  globalThis.questionnaireAndAnalysis = { questionnaireResponse, regimenRangeResponse, analysisResult };\n})().catch((error) => {\n  globalThis.scrib.show('<pre>' + String(error && error.message ? error.message : error) + '</pre>');\n});","status":"","output":""}
  ]
}
