{
  "metadata": {"name": "DFU HBOT Bounded Regimen and Execution Burden (Scribbler)", "language_info": {"name": "JavaScript", "version": "ES2020"}},
  "jsnbversion": "v0.1",
  "run_on_load": false,
  "source": "https://github.com/kgrid-objects/FAIR-DO-Workshop/tree/HEAD/collection/dfu-hbot-bounded-regimen-and-execution-burden",
  "cells": [
    {"type": "html", "code": "<h1>DFU HBOT Bounded Regimen and Execution Burden</h1><p>Interactive Scribbler demonstration of the regimen range, burden questionnaire, and burden response analysis.</p>", "status": "", "output": ""},
    {"type": "code", "code": "const SPECIFICATION_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/versions/cks-1.0';\nconst KNOWLEDGE_PACKAGE_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/knowledge-packages/general-dfu-regimen/versions/1.0';\nfunction showRegimenRange(request) {\n  if (!request || request.request_type !== 'show_regimen_range') throw new Error('request_type must be show_regimen_range.');\n  return { specification_iri: SPECIFICATION_IRI, response_type: 'fixed_regimen_range_response', status: 'completed', knowledge_package_iri: KNOWLEDGE_PACKAGE_IRI, knowledge_scope: 'general_not_patient_specific', indication: 'diabetes_related_foot_ulcer', shorter_regimen_scenario: {episodes: 30, sessions_per_week: 5, course_weeks: 6.0}, longer_regimen_scenario: {episodes: 40, sessions_per_week: 5, course_weeks: 8.0}, combined_range: {episodes: [30, 40], sessions_per_week: 5, course_weeks: [6.0, 8.0]}, scheduled_facility_hours_per_episode: {value: 3.0, unit: 'h'}, tailored_to_patient: false, display_label: 'General DFU HBOT planning range: approximately 30-40 episodes, usually five per week, over approximately 6-8 weeks.'};\n}\nglobalThis.showRegimenRange = showRegimenRange; globalThis.scrib.show('<h3>Regimen Range loaded.</h3>');", "status": "", "output": ""},
    {"type": "code", "code": "const PROVIDER_ROSTER_VERSION_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/provider-rosters/appendix-e/versions/1.0';\nconst QUESTIONS = [{id:'Q01',text:'Where will you receive hyperbaric oxygen therapy?',prompt:'Enter provider IRI (example: https://kgrid.org/cks/dfu-hbot-burden/providers/e-001):'},{id:'Q02',text:'About how many miles is it one way to this location?',prompt:'Enter one_way_miles (0 to 1000):'},{id:'Q03',text:'About how long does that trip usually take one way?',prompt:'Enter one_way_travel_minutes (0 to 1440):'},{id:'Q04',text:'How much difficulty do you expect with attending scheduled treatments?',prompt:'Enter difficulty [none|some|major]:'}];\nfunction promptLine(prompt) { if (!globalThis.$$ || typeof globalThis.$$.input !== 'function') throw new Error('Scribbler input is unavailable.'); return globalThis.$$.input({prompt}); }\nasync function runBurdenQuestionnaire() { const a={}; for(const q of QUESTIONS){ console.log(`\\n${q.id}: ${q.text}`); a[q.id]=String(await promptLine(`${q.prompt} `)).trim(); } const p=a.Q01,m=Number(a.Q02),t=Number(a.Q03),d=a.Q04.toLowerCase(); if(!/^https:\\/\\/kgrid\\.org\\/cks\\/dfu-hbot-burden\\/providers\\/e-(00[1-9]|0[1-9][0-9]|1[0-3][0-9]|14[01])$/.test(p)) throw new Error('Q01 must be a valid provider IRI.'); if(!Number.isFinite(m)||m<0||m>1000) throw new Error('Q02 must be 0 through 1000.'); if(!Number.isFinite(t)||t<0||t>1440) throw new Error('Q03 must be 0 through 1440.'); if(!['none','some','major'].includes(d)) throw new Error('Q04 must be none, some, or major.'); return {provider_roster_version_iri:PROVIDER_ROSTER_VERSION_IRI,response_projection:{hyperbaric_oxygen_therapy_location:p,one_way_miles:m,one_way_travel_minutes:t,weekday_attendance_difficulty:d},confirmed:true}; }\nglobalThis.runBurdenQuestionnaire = runBurdenQuestionnaire; globalThis.scrib.show('<h3>Interactive questionnaire loaded.</h3>');", "status": "", "output": ""},
    {"type": "code", "code": "const ROSTER_URL = 'https://raw.githubusercontent.com/kgrid-objects/FAIR-DO-Workshop/HEAD/collection/dfu-hbot-bounded-regimen-and-execution-burden/spec/DFU_HBOT_Provider_Roster_Snapshot_Version_1_0.json';\nconst PROVIDER_ROSTER_VERSION_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/provider-rosters/appendix-e/versions/1.0';\nconst ASSUMPTIONS=[{code:'ASM-01',text:'General DFU planning regimen range of 30-40 episodes at five sessions per week is used.'},{code:'ASM-02',text:'A fixed three-hour scheduled facility block per treatment episode is used as a planning assumption.'},{code:'ASM-03',text:'Round trip is estimated as two times the reported one-way miles and minutes.'},{code:'ASM-04',text:'Reported travel values are planning estimates and are not independently verified.'}];\nfunction endpoint(v,dir){const q=v>=0&&v<10?0.1:1;const n=dir==='upper'?Math.ceil(v/q)*q:Math.floor(v/q)*q;return Math.round(n*10)/10;} function nearest(v){const q=v>=0&&v<10?0.1:1;return Math.round(Math.floor(v/q+0.5)*q*10)/10;}\nasync function calculateBurdenRange(questionnaireResponse,regimenRangeResponse){const roster=await fetch(ROSTER_URL).then(r=>r.json());const p=questionnaireResponse.response_projection;const provider=roster.records.find(x=>x.provider_iri===p.hyperbaric_oxygen_therapy_location);if(!provider||provider.selectable!==true)throw new Error('Selected provider was not found in the selectable roster.');const t=p.one_way_travel_minutes*2/60,d=p.one_way_miles*2;const scenarios=[{name:'shorter_regimen',episodes:30,weeks:6.0,direction:'lower'},{name:'longer_regimen',episodes:40,weeks:8.0,direction:'upper'}];const burden={};for(const s of scenarios){const travel=s.episodes*t;burden[s.name]={episodes:s.episodes,course_weeks:s.weeks,travel_hours:endpoint(travel,s.direction),facility_hours:s.episodes*3,total_patient_hours:endpoint(travel+s.episodes*3,s.direction),course_miles:endpoint(s.episodes*d,s.direction)};}const band=t<1?'low':t<2?'moderate':t<3?'high':'very_high',ts={low:1,moderate:2,high:3,very_high:4}[band],difficulty=p.weekday_attendance_difficulty,score=difficulty==='major'?(ts>=3?5:4):difficulty==='some'?Math.min(5,ts+1):ts,categories=['low_execution_burden','moderate_execution_burden','high_execution_burden','very_high_execution_burden','extreme_execution_burden'],labels=['Low execution burden','Moderate execution burden','High execution burden','Very high execution burden','Extreme execution burden'];const attendance={reported_value:difficulty,display_text:{none:'No weekday-attendance difficulty reported',some:'Some weekday-attendance difficulty reported',major:'Major weekday-attendance difficulty reported'}[difficulty]};const travelDriver=band==='low'?null:`${band} reported travel time (${String(nearest(t)).replace(/\\.0$/,'')} round-trip hours)`,attendanceDriver=difficulty==='major'?'Major weekday-attendance difficulty':difficulty==='some'?'Some weekday-attendance difficulty':null,primary=attendanceDriver||travelDriver||'Repeated attendance (30-40 episodes; five per week)',secondary=primary===attendanceDriver?(travelDriver||'Repeated attendance (30-40 episodes; five per week)'):(attendanceDriver||'Repeated attendance (30-40 episodes; five per week)'),shorter=burden.shorter_regimen,longer=burden.longer_regimen;return {status:'completed',result_code:`RESULT-${categories[score-1].toUpperCase()}`,objective_burden:{fixed_regimen_range_response:regimenRangeResponse,hyperbaric_oxygen_therapy_location_reference:{provider_roster_version_iri:PROVIDER_ROSTER_VERSION_IRI,roster_record_iri:provider.roster_record_iri,provider_iri:provider.provider_iri,compact_id:provider.compact_id,facility_listing:provider.facility_listing,jurisdiction:provider.jurisdiction,address_status:provider.address_status,normalized_address_candidate:provider.normalized_address_candidate},reported_one_way_travel:{miles:p.one_way_miles,minutes:p.one_way_travel_minutes},burden_by_regimen_scenario:burden,overall_burden_range:{episodes:[shorter.episodes,longer.episodes],travel_hours:[shorter.travel_hours,longer.travel_hours],facility_hours:[shorter.facility_hours,longer.facility_hours],total_patient_hours:[shorter.total_patient_hours,longer.total_patient_hours],course_miles:[shorter.course_miles,longer.course_miles]},travel_band:{value:band,basis:'reported_one_way_minutes_doubled'}},weekday_attendance_feasibility:attendance,execution_burden_level:{score,category:categories[score-1],primary_driver:primary,secondary_driver:secondary,display_text:labels[score-1]},sensitivity:{longer_minus_shorter_episodes:10,incremental_travel_hours:nearest(10*t),incremental_facility_hours:30,incremental_total_hours:nearest(10*(t+3)),incremental_miles:nearest(10*d),incremental_weeks:2.0},assumptions:ASSUMPTIONS,evidence_sources:[],error:null,warnings:[]};}\nglobalThis.calculateBurdenRange=calculateBurdenRange; globalThis.scrib.show('<h3>Burden analysis loaded.</h3>');", "status": "", "output": ""},
    {"type": "html", "code": "<h2>Run the DFU HBOT Questionnaire and Analysis</h2><p>Run this cell to answer the four questions and see the regimen and burden results.</p>", "status": "", "output": ""},
    {"type": "code", "code": "(async()=>{globalThis.questionnaireAndAnalysisPromise=(async()=>{const questionnaireResponse=await globalThis.runBurdenQuestionnaire();globalThis.scrib.show('<h3>Completed Questionnaire Response</h3><pre>'+JSON.stringify(questionnaireResponse,null,2)+'</pre>');const regimenRangeResponse=globalThis.showRegimenRange({request_type:'show_regimen_range'});globalThis.scrib.show('<h3>Fixed Regimen Range Response</h3><pre>'+JSON.stringify(regimenRangeResponse,null,2)+'</pre>');const analysisResult=await globalThis.calculateBurdenRange(questionnaireResponse,regimenRangeResponse);globalThis.scrib.show('<h3>Burden Analysis Result</h3><pre>'+JSON.stringify(analysisResult,null,2)+'</pre>');return{questionnaireResponse,regimenRangeResponse,analysisResult};})();return globalThis.questionnaireAndAnalysisPromise;})().catch(error=>{globalThis.scrib.show('<pre>'+String(error&&error.message?error.message:error)+'</pre>');throw error;});", "status": "", "output": ""}
  ]
}
