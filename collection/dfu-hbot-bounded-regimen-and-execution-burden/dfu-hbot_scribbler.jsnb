{
  "metadata": {
    "name": "DFU HBOT Bounded Regimen and Execution Burden (Scribbler)",
    "language_info": { "name": "JavaScript", "version": "ES2020" }
  },
  "jsnbversion": "v0.1",
  "run_on_load": false,
  "source": "https://github.com/kgrid-objects/FAIR-DO-Workshop/tree/HEAD/collection/dfu-hbot-bounded-regimen-and-execution-burden",
  "cells": [
    {
      "type": "html",
      "code": "<h1>DFU HBOT Bounded Regimen and Execution Burden</h1><p>This Scribbler notebook demonstrates the regimen range, interactive burden questionnaire, and burden response analysis.</p>",
      "status": "",
      "output": ""
    },
    {
      "type": "code",
      "code": "const SPECIFICATION_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/versions/cks-1.0';\nconst KNOWLEDGE_PACKAGE_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/knowledge-packages/general-dfu-regimen/versions/1.0';\nfunction showRegimenRange(request) {\n  if (!request || request.request_type !== 'show_regimen_range') throw new Error('request_type must be show_regimen_range.');\n  return { specification_iri: SPECIFICATION_IRI, response_type: 'fixed_regimen_range_response', status: 'completed', knowledge_package_iri: KNOWLEDGE_PACKAGE_IRI, knowledge_scope: 'general_not_patient_specific', indication: 'diabetes_related_foot_ulcer', shorter_regimen_scenario: { episodes: 30, sessions_per_week: 5, course_weeks: 6.0 }, longer_regimen_scenario: { episodes: 40, sessions_per_week: 5, course_weeks: 8.0 }, combined_range: { episodes: [30, 40], sessions_per_week: 5, course_weeks: [6.0, 8.0] }, scheduled_facility_hours_per_episode: { value: 3.0, unit: 'h' }, tailored_to_patient: false, display_label: 'General DFU HBOT planning range: approximately 30-40 episodes, usually five per week, over approximately 6-8 weeks.' };\n}\nglobalThis.showRegimenRange = showRegimenRange;\nglobalThis.scrib.show('<h3>Regimen Range function loaded.</h3>');",
      "status": "",
      "output": ""
    },
    {
      "type": "code",
      "code": "const readline = require('node:readline');\nconst { stdin, stdout } = require('node:process');\nconst PROVIDER_ROSTER_VERSION_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/provider-rosters/appendix-e/versions/1.0';\nconst QUESTIONS = [\n  { id: 'Q01', text: 'Where will you receive hyperbaric oxygen therapy?', prompt: 'Enter provider IRI (example: https://kgrid.org/cks/dfu-hbot-burden/providers/e-001):' },\n  { id: 'Q02', text: 'About how many miles is it one way to this location?', prompt: 'Enter one_way_miles (0 to 1000):' },\n  { id: 'Q03', text: 'About how long does that trip usually take one way?', prompt: 'Enter one_way_travel_minutes (0 to 1440):' },\n  { id: 'Q04', text: 'How much difficulty do you expect with attending scheduled treatments?', prompt: 'Enter difficulty [none|some|major]:' }\n];\nfunction promptLine(prompt) {\n  if (globalThis.$$ && typeof globalThis.$$.input === 'function') return globalThis.$$.input({ prompt });\n  const rl = readline.createInterface({ input: stdin, output: stdout });\n  return new Promise((resolve) => rl.question(prompt, (answer) => { rl.close(); resolve(answer); }));\n}\nasync function runBurdenQuestionnaire() {\n  const answers = {};\n  for (const question of QUESTIONS) { console.log(`\\n${question.id}: ${question.text}`); answers[question.id] = String(await promptLine(`${question.prompt} `)).trim(); }\n  const provider = answers.Q01; const miles = Number(answers.Q02); const minutes = Number(answers.Q03); const difficulty = answers.Q04.toLowerCase();\n  if (!/^https:\\/\\/kgrid\\.org\\/cks\\/dfu-hbot-burden\\/providers\\/e-(00[1-9]|0[1-9][0-9]|1[0-3][0-9]|14[01])$/.test(provider)) throw new Error('Q01 must be a valid provider IRI.');\n  if (!Number.isFinite(miles) || miles < 0 || miles > 1000) throw new Error('Q02 must be 0 through 1000.');\n  if (!Number.isFinite(minutes) || minutes < 0 || minutes > 1440) throw new Error('Q03 must be 0 through 1440.');\n  if (!['none', 'some', 'major'].includes(difficulty)) throw new Error('Q04 must be none, some, or major.');\n  return { provider_roster_version_iri: PROVIDER_ROSTER_VERSION_IRI, response_projection: { hyperbaric_oxygen_therapy_location: provider, one_way_miles: miles, one_way_travel_minutes: minutes, weekday_attendance_difficulty: difficulty }, confirmed: true };\n}\nglobalThis.runBurdenQuestionnaire = runBurdenQuestionnaire;\nglobalThis.scrib.show('<h3>Interactive questionnaire function loaded.</h3>');",
      "status": "",
      "output": ""
    },
    {
      "type": "code",
      "code": "const providerRosterSnapshot = require('./spec/DFU_HBOT_Provider_Roster_Snapshot_Version_1_0.json');\nconst PROVIDER_ROSTER_VERSION_IRI = 'https://kgrid.org/cks/dfu-hbot-burden/provider-rosters/appendix-e/versions/1.0';\nconst ASSUMPTIONS = [\n  { code: 'ASM-01', text: 'General DFU planning regimen range of 30-40 episodes at five sessions per week is used; it was not selected or calculated for the patient.' },\n  { code: 'ASM-02', text: 'A single fixed three-hour scheduled facility block per treatment episode is used as a conservative planning assumption.' },\n  { code: 'ASM-03', text: 'Round trip is estimated as two times the patient-reported usual one-way miles and minutes.' },\n  { code: 'ASM-04', text: 'Reported travel values are planning estimates and are not independently verified by the engine.' }\n];\nfunction endpoint(value, direction) { const q = value >= 0 && value < 10 ? 0.1 : 1; const n = direction === 'upper' ? Math.ceil(value / q) * q : Math.floor(value / q) * q; return Math.round(n * 10) / 10; }\nfunction nearest(value) { const q = value >= 0 && value < 10 ? 0.1 : 1; return Math.round(Math.floor(value / q + 0.5) * q * 10) / 10; }\nfunction calculateBurdenRange(questionnaireResponse, regimenRangeResponse) {\n  const p = questionnaireResponse.response_projection; const provider = providerRosterSnapshot.records.find((record) => record.provider_iri === p.hyperbaric_oxygen_therapy_location);\n  if (!provider || provider.selectable !== true) throw new Error('Selected provider was not found in the selectable roster.');\n  const t = p.one_way_travel_minutes * 2 / 60; const d = p.one_way_miles * 2; const scenarios = [{ name: 'shorter_regimen', episodes: 30, weeks: 6.0, direction: 'lower' }, { name: 'longer_regimen', episodes: 40, weeks: 8.0, direction: 'upper' }]; const burden = {};\n  for (const s of scenarios) { const travel = s.episodes * t; burden[s.name] = { episodes: s.episodes, course_weeks: s.weeks, travel_hours: endpoint(travel, s.direction), facility_hours: s.episodes * 3, total_patient_hours: endpoint(travel + s.episodes * 3, s.direction), course_miles: endpoint(s.episodes * d, s.direction) }; }\n  const band = t < 1 ? 'low' : t < 2 ? 'moderate' : t < 3 ? 'high' : 'very_high'; const travelScore = { low: 1, moderate: 2, high: 3, very_high: 4 }[band]; const difficulty = p.weekday_attendance_difficulty; const score = difficulty === 'major' ? (travelScore >= 3 ? 5 : 4) : difficulty === 'some' ? Math.min(5, travelScore + 1) : travelScore; const categories = ['low_execution_burden', 'moderate_execution_burden', 'high_execution_burden', 'very_high_execution_burden', 'extreme_execution_burden']; const labels = ['Low execution burden', 'Moderate execution burden', 'High execution burden', 'Very high execution burden', 'Extreme execution burden'];\n  const attendance = { reported_value: difficulty, display_text: { none: 'No weekday-attendance difficulty reported', some: 'Some weekday-attendance difficulty reported', major: 'Major weekday-attendance difficulty reported' }[difficulty] }; const attendanceDriver = difficulty === 'major' ? 'Major weekday-attendance difficulty' : difficulty === 'some' ? 'Some weekday-attendance difficulty' : null; const travelDriver = band === 'low' ? null : `${band} reported travel time (${String(nearest(t)).replace(/\\.0$/, '')} round-trip hours)`; const primary = attendanceDriver || travelDriver || 'Repeated attendance (30-40 episodes; five per week)'; const secondary = primary === attendanceDriver ? (travelDriver || 'Repeated attendance (30-40 episodes; five per week)') : (attendanceDriver || 'Repeated attendance (30-40 episodes; five per week)'); const shorter = burden.shorter_regimen; const longer = burden.longer_regimen;\n  return { status: 'completed', result_code: `RESULT-${categories[score - 1].toUpperCase()}`, objective_burden: { fixed_regimen_range_response: regimenRangeResponse, hyperbaric_oxygen_therapy_location_reference: { provider_roster_version_iri: PROVIDER_ROSTER_VERSION_IRI, roster_record_iri: provider.roster_record_iri, provider_iri: provider.provider_iri, compact_id: provider.compact_id, facility_listing: provider.facility_listing, jurisdiction: provider.jurisdiction, address_status: provider.address_status, normalized_address_candidate: provider.normalized_address_candidate }, reported_one_way_travel: { miles: p.one_way_miles, minutes: p.one_way_travel_minutes }, burden_by_regimen_scenario: burden, overall_burden_range: { episodes: [shorter.episodes, longer.episodes], travel_hours: [shorter.travel_hours, longer.travel_hours], facility_hours: [shorter.facility_hours, longer.facility_hours], total_patient_hours: [shorter.total_patient_hours, longer.total_patient_hours], course_miles: [shorter.course_miles, longer.course_miles] }, travel_band: { value: band, basis: 'reported_one_way_minutes_doubled' } }, weekday_attendance_feasibility: attendance, execution_burden_level: { score, category: categories[score - 1], primary_driver: primary, secondary_driver: secondary, display_text: labels[score - 1] }, sensitivity: { longer_minus_shorter_episodes: 10, incremental_travel_hours: nearest(10 * t), incremental_facility_hours: 30, incremental_total_hours: nearest(10 * (t + 3)), incremental_miles: nearest(10 * d), incremental_weeks: 2.0 }, assumptions: ASSUMPTIONS, evidence_sources: [], error: null, warnings: [] };\n}\nglobalThis.calculateBurdenRange = calculateBurdenRange; globalThis.scrib.show('<h3>Burden analysis function loaded.</h3>');",
      "status": "",
      "output": ""
    },
    {
      "type": "html",
      "code": "<h2>Run the DFU HBOT Questionnaire and Analysis</h2><p>This cell asks the four questionnaire questions, displays the completed response and regimen range, and analyzes the recorded response.</p>",
      "status": "",
      "output": ""
    },
    {
      "type": "code",
      "code": "(async () => { globalThis.questionnaireAndAnalysisPromise = (async () => { const questionnaireResponse = await globalThis.runBurdenQuestionnaire(); globalThis.scrib.show('<h3>Completed Questionnaire Response</h3><pre>' + JSON.stringify(questionnaireResponse, null, 2) + '</pre>'); const regimenRangeResponse = globalThis.showRegimenRange({ request_type: 'show_regimen_range' }); globalThis.scrib.show('<h3>Fixed Regimen Range Response</h3><pre>' + JSON.stringify(regimenRangeResponse, null, 2) + '</pre>'); const analysisResult = globalThis.calculateBurdenRange(questionnaireResponse, regimenRangeResponse); globalThis.scrib.show('<h3>Burden Analysis Result</h3><pre>' + JSON.stringify(analysisResult, null, 2) + '</pre>'); return { questionnaireResponse, regimenRangeResponse, analysisResult }; })(); return globalThis.questionnaireAndAnalysisPromise; })().catch((error) => { globalThis.scrib.show('<pre>' + String(error && error.message ? error.message : error) + '</pre>'); throw error; });",
      "status": "",
      "output": ""
    }
  ]
}
