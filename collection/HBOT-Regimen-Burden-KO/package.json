{
  "name": "@dfu-hbot/bounded-regimen-and-execution-burden",
  "version": "1.0.0",
  "description": "DFU HBOT burden package implementing regimen range, questionnaire logic, and burden response analysis",
  "main": "src/index.js",
  "type": "commonjs",
  "bin": {
    "dfu-hbot-burden": "src/cli/dfu-hbot-burden.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./regimen-range": "./src/regimen-range.js",
    "./questionnaire": "./src/questionnaire-logic.js",
    "./analysis": "./src/burden-response-analysis.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "scripts": {
