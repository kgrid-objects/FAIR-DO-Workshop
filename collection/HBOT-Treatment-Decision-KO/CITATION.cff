title: "Clinical Practice Guideline Algorithm for Hyperbaric Oxygen Therapy in Diabetic Foot Ulcers Knowledge Object"
type: software
version: 1.0.0
doi: 10.5281/zenodo.23367087
authors:
  - name: "Knowledge Systems Lab"
    affiliation: "Department of Learning Health Sciences, University of Michigan Medical School"
    email: "kgrid-developers@umich.edu"
